<Page x:Class="BasketballRulesCms.App.Views.AddEditRulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:conv="clr-namespace:BasketballRulesCms.App.Views.Converters"
      Background="#151515">

    <Page.Resources>
        <conv:BoolToVisibility        x:Key="BoolVis"/>
        <conv:InverseBoolToVisibility x:Key="InvBoolVis"/>
        <conv:RelativePathToImage     x:Key="RelImg"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="#1F1F1F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <fa5:SvgAwesome Grid.Column="0"
                            Icon="Solid_Edit"
                            Height="22" Width="22"
                            Foreground="#FF6B00"
                            Margin="20,0,12,0"
                            VerticalAlignment="Center"/>

            <TextBlock x:Name="PageTitleTb"
                       Grid.Column="1"
                       Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0"/>
        </Grid>
        <Rectangle Grid.Row="0" Height="3" VerticalAlignment="Bottom" Fill="#FF6B00"/>

        <!-- ══ Form body ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left col: basic fields + image ──────────────────────── -->
            <Border Grid.Column="0"
                    Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- Rule number -->
                        <TextBlock Style="{StaticResource SectionLabel}" Text="BROJ PRAVILA  (brojevno polje)"/>
                        <TextBox Style="{StaticResource PrimaryTb}"
                                 Text="{Binding RuleNumberText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Unesite redni broj pravila. Obavezno." Cursor="IBeam"/>
                        <TextBlock Style="{StaticResource ValidationText}"
                                   Visibility="{Binding HasRuleNumberError, Converter={StaticResource BoolVis}}"
                                   Text="{Binding RuleNumberError}"/>

                        <!-- Title -->
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,16,0,4" Text="NAZIV PRAVILA  (Hyperlink u tabeli)"/>
                        <TextBox Style="{StaticResource PrimaryTb}"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Naziv koji se prikazuje kao Hyperlink." Cursor="IBeam"/>
                        <TextBlock Style="{StaticResource ValidationText}"
                                   Visibility="{Binding HasTitleError, Converter={StaticResource BoolVis}}"
                                   Text="{Binding TitleError}"/>

                        <!-- Image picker -->
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,16,0,4" Text="SLIKA"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource PrimaryTb}"
                                     Text="{Binding ImageHint}"
                                     IsReadOnly="True"
                                     ToolTip="Putanja se ne unosi ručno — koristite dugme."/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryBtn}"
                                    Width="40" Margin="6,0,0,0"
                                    Click="PickImage_Click"
                                    Cursor="Hand"
                                    ToolTip="Otvori dijalog za izbor slike">
                                <fa5:SvgAwesome Icon="Solid_FolderOpen" Height="14" Foreground="#0A0A0A"/>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource ValidationText}"
                                   Visibility="{Binding HasImageError, Converter={StaticResource BoolVis}}"
                                   Text="{Binding ImageError}"/>

                        <!-- Image preview -->
                        <Border Margin="0,10,0,0"
                                Background="#252525" BorderBrush="#383838" BorderThickness="1"
                                CornerRadius="4" Height="185" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF6B00" Direction="0" ShadowDepth="0" BlurRadius="8" Opacity="0.2"/>
                            </Border.Effect>
                            <Grid>
                                <StackPanel x:Name="ImgPlaceholder"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasImagePreview, Converter={StaticResource InvBoolVis}}">
                                    <fa5:SvgAwesome Icon="Regular_Image" Height="34" Foreground="#444"/>
                                    <TextBlock Text="Nema izabrane slike" Foreground="#555"
                                               FontFamily="Segoe UI" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Image Stretch="Uniform" Margin="8"
                                       Source="{Binding ImagePath, Converter={StaticResource RelImg}}"
                                       Visibility="{Binding HasImagePreview, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Right col: RTF editor ───────────────────────────────── -->
            <Border Grid.Column="2"
                    Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                    CornerRadius="4">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionLabel}"
                               Text="OPIS PRAVILA  (RTF tekst editor — čuva se u .rtf datoteci)"/>

                    <!-- Toolbar -->
                    <ToolBar Grid.Row="1"
                             Background="#2A2A2A"
                             Margin="0,8,0,4"
                             ToolBarTray.IsLocked="True">

                        <ToggleButton x:Name="BoldBtn"
                                      Style="{StaticResource EditorToggle}"
                                      Width="32" Height="28" Margin="0,0,3,0"
                                      Click="Bold_Click" ToolTip="Bold (Ctrl+B)">
                            <fa5:SvgAwesome Icon="Solid_Bold" Height="12" Foreground="White"/>
                        </ToggleButton>

                        <ToggleButton x:Name="ItalicBtn"
                                      Style="{StaticResource EditorToggle}"
                                      Width="32" Height="28" Margin="0,0,3,0"
                                      Click="Italic_Click" ToolTip="Italic (Ctrl+I)">
                            <fa5:SvgAwesome Icon="Solid_Italic" Height="12" Foreground="White"/>
                        </ToggleButton>

                        <ToggleButton x:Name="UnderlineBtn"
                                      Style="{StaticResource EditorToggle}"
                                      Width="32" Height="28" Margin="0,0,10,0"
                                      Click="Underline_Click" ToolTip="Underline (Ctrl+U)">
                            <fa5:SvgAwesome Icon="Solid_Underline" Height="12" Foreground="White"/>
                        </ToggleButton>

                        <Separator Background="#383838" Width="1" Margin="0,2,8,2"/>

                        <ComboBox x:Name="FontFamilyBox"
                                  Background="#2A2A2A" Foreground="#F0F0F0"
                                  Width="180" IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  SelectionChanged="FontFamily_Changed"
                                  ToolTip="Font familija">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock MaxWidth="200"
                                               FontFamily="{Binding Source}"
                                               Text="{Binding Source}"
                                               Foreground="#F0F0F0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox x:Name="FontSizeBox"
                                  Background="#2A2A2A" Foreground="#F0F0F0"
                                  Width="80" Margin="5,0,0,0" IsEditable="True"
                                  SelectionChanged="FontSize_Changed"
                                  ToolTip="Veličina slova"/>

                        <Separator Background="#383838" Width="1" Margin="5,2,5,2"/>

                        <!-- Colour swatch + dropdown (F1 pattern) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="ColourSwatch"
                                       Width="28" Height="20" Margin="0,0,3,0"
                                       Fill="White" VerticalAlignment="Center" Cursor="Hand"
                                       ToolTip="Trenutna boja teksta"/>
                            <ComboBox x:Name="ColorBox"
                                      Width="20" Height="22"
                                      SelectionChanged="Color_Changed"
                                      ToolTip="Promeni boju teksta — sve sistemske boje">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="14" Height="14" Margin="0,0,6,0" Fill="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                    </ToolBar>

                    <!-- RichTextBox -->
                    <RichTextBox x:Name="Editor"
                                 Grid.Row="2"
                                 Background="#252525" Foreground="#F0F0F0"
                                 BorderBrush="#383838" BorderThickness="1"
                                 Padding="10"
                                 FontFamily="Segoe UI" FontSize="13"
                                 SelectionChanged="Editor_SelectionChanged"
                                 TextChanged="Editor_TextChanged"
                                 AcceptsReturn="True"
                                 ToolTip="Unesi opis pravila. Koristite toolbar za formatiranje."/>

                    <!-- Status bar: validation + word count -->
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource ValidationText}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasRtfError, Converter={StaticResource BoolVis}}"
                                   Text="{Binding RtfError}"/>

                        <Border Grid.Column="1"
                                Background="#252525" BorderBrush="#383838" BorderThickness="1,0,1,1"
                                Padding="10,4">
                            <TextBlock x:Name="WordCountTb"
                                       Foreground="#666" FontFamily="Segoe UI" FontSize="11"
                                       Text="{Binding WordCountText}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ Footer buttons ═════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,12,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryBtn}"
                    Width="150"
                    Click="Save_Click"
                    ToolTip="Sačuvaj pravilo">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Save" Height="13" Foreground="#0A0A0A" Margin="0,0,7,0"/>
                    <TextBlock Text="SAČUVAJ" VerticalAlignment="Center" Foreground="#0A0A0A"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Style="{StaticResource SecondaryBtn}"
                    Width="150"
                    Click="Back_Click"
                    ToolTip="Odustani i vrati se na listu">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Times" Height="13" Foreground="#AAAAAA" Margin="0,0,7,0"/>
                    <TextBlock Text="ODUSTANI" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
