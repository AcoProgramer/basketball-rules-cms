<Page x:Class="BasketballRulesCms.App.Views.RuleDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:conv="clr-namespace:BasketballRulesCms.App.Views.Converters"
      Background="#151515">

    <Page.Resources>
        <conv:RelativePathToImage x:Key="RelImg"/>
        <conv:DateToString        x:Key="DtFmt"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header (F1 pattern) ════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="#1F1F1F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <fa5:SvgAwesome Grid.Column="0"
                            Icon="Solid_Eye"
                            Height="22" Width="22"
                            Foreground="#FF6B00"
                            Margin="20,0,12,0"
                            VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="DETALJAN PRIKAZ PRAVILA"
                       Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center"/>
        </Grid>
        <Rectangle Grid.Row="0" Height="3" VerticalAlignment="Bottom" Fill="#FF6B00"/>

        <!-- ══ Content ════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="24,18,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left: image + meta ──────────────────────────────── -->
                <StackPanel Grid.Column="0">

                    <!-- Image with orange border glow -->
                    <Border Background="#252525"
                            BorderBrush="#FF6B00" BorderThickness="2"
                            CornerRadius="4" Height="200" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF6B00" Direction="0" ShadowDepth="0"
                                              BlurRadius="14" Opacity="0.5"/>
                        </Border.Effect>
                        <Image x:Name="RuleImage" Stretch="UniformToFill" Margin="4"/>
                    </Border>

                    <!-- Rule number — big Agency FB number (F1 stat box) -->
                    <Border Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                            CornerRadius="4" Padding="18,14" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <fa5:SvgAwesome Icon="Solid_ListOl" Height="28" Width="28"
                                            Foreground="#FF6B00" VerticalAlignment="Center"
                                            Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BROJ PRAVILA"
                                           Foreground="#555"
                                           FontFamily="Agency FB, Impact, Arial Black"
                                           FontSize="12"/>
                                <TextBlock x:Name="RuleNumberTb"
                                           Foreground="White"
                                           FontFamily="Agency FB, Impact, Arial Black"
                                           FontSize="38" FontWeight="Bold"
                                           Margin="0,-8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Date added -->
                    <Border Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                            CornerRadius="4" Padding="18,14" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <fa5:SvgAwesome Icon="Solid_CalendarAlt" Height="22" Width="22"
                                            Foreground="#FF6B00" VerticalAlignment="Center"
                                            Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DATUM DODAVANJA"
                                           Foreground="#555"
                                           FontFamily="Agency FB, Impact, Arial Black"
                                           FontSize="12"/>
                                <TextBlock x:Name="DateTb"
                                           Foreground="White"
                                           FontFamily="Agency FB, Impact, Arial Black"
                                           FontSize="16"
                                           Margin="0,-2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Right: title + RTF body ─────────────────────────── -->
                <StackPanel Grid.Column="2">

                    <!-- Title label -->
                    <TextBlock Text="NAZIV PRAVILA"
                               Foreground="#FF6B00"
                               FontFamily="Agency FB, Impact, Arial Black"
                               FontSize="13"/>

                    <TextBlock x:Name="TitleTb"
                               Foreground="White"
                               FontFamily="Agency FB, Impact, Arial Black"
                               FontSize="34" FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,-4,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF6B00" Direction="0" ShadowDepth="0"
                                              BlurRadius="12" Opacity="0.55"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Divider (F1 pattern) -->
                    <Rectangle Height="2" Fill="#FF6B00" Margin="0,12,0,18"/>

                    <!-- Description label -->
                    <TextBlock Text="OPIS PRAVILA"
                               Foreground="#FF6B00"
                               FontFamily="Agency FB, Impact, Arial Black"
                               FontSize="13"
                               Margin="0,0,0,10"/>

                    <!-- RTF viewer — no editable controls visible (spec requirement) -->
                    <Border Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                            CornerRadius="4" Padding="4" MinHeight="280">
                        <FlowDocumentScrollViewer x:Name="RtfViewer"
                                                  Background="Transparent"
                                                  Foreground="#F0F0F0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsToolBarVisible="False"
                                                  IsSelectionEnabled="False"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ══ Footer ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,12,24,16">
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryBtn}"
                    Width="150"
                    Click="Back_Click"
                    ToolTip="Vrati se na listu pravila">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="13"
                                    Foreground="#AAAAAA" Margin="0,0,7,0"/>
                    <TextBlock Text="NAZAD" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
