<Page x:Class="BasketballRulesCms.App.Views.RulesListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:conv="clr-namespace:BasketballRulesCms.App.Views.Converters"
      Background="#151515">

    <Page.Resources>
        <conv:RelativePathToImage x:Key="RelImg"/>
        <conv:DateToString        x:Key="DtFmt"/>
        <conv:BoolToVisibility    x:Key="BoolVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header (F1 style) ══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="#1F1F1F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="20,0">
                <Viewbox Width="26" Height="26" Margin="0,0,12,0">
                    <Canvas Width="26" Height="26">
                        <Ellipse Width="24" Height="24" Canvas.Left="1" Canvas.Top="1"
                                 Stroke="#FF6B00" StrokeThickness="2.5" Fill="#1F1F1F"/>
                        <Line X1="1" Y1="13" X2="25" Y2="13" Stroke="#FF6B00" StrokeThickness="1.5"/>
                        <Line X1="13" Y1="1" X2="13" Y2="25" Stroke="#FF6B00" StrokeThickness="1.5"/>
                        <Path Data="M6,3 Q13,10 6,23"  Stroke="#FF6B00" StrokeThickness="1.5" Fill="Transparent"/>
                        <Path Data="M20,3 Q13,10 20,23" Stroke="#FF6B00" StrokeThickness="1.5" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="PRAVILA KOŠARKE"
                           Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF6B00" Direction="0" ShadowDepth="0" BlurRadius="12" Opacity="0.7"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- Right action buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,16,0">

                <!-- Admin only -->
                <Button x:Name="AddBtn"
                        Style="{StaticResource PrimaryBtn}"
                        Width="140" Margin="0,0,10,0"
                        Click="Add_Click"
                        ToolTip="Dodaj novo pravilo (samo Admin)">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_Plus" Height="12" Foreground="#0A0A0A" Margin="0,0,6,0"/>
                        <TextBlock Text="DODAJ" VerticalAlignment="Center" Foreground="#0A0A0A"/>
                    </StackPanel>
                </Button>

                <Button x:Name="DeleteBtn"
                        Style="{StaticResource DangerBtn}"
                        Width="160" Margin="0,0,10,0"
                        Click="Delete_Click"
                        ToolTip="Obriši označena pravila (samo Admin)">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_Trash" Height="12" Foreground="#CC2200" Margin="0,0,6,0"/>
                        <TextBlock Text="OBRIŠI OZNAČENA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryBtn}"
                        Width="110"
                        Click="Logout_Click"
                        ToolTip="Odjavi se i vrati na login">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_SignOutAlt" Height="12" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                        <TextBlock Text="ODJAVA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Orange accent line (F1 pattern) -->
        <Rectangle Grid.Row="0" Height="3" VerticalAlignment="Bottom" Fill="#FF6B00"/>

        <!-- ══ Toolbar — select all ════════════════════════════════════════ -->
        <Grid x:Name="ToolbarRow" Grid.Row="1" Margin="20,12,20,8">
            <CheckBox x:Name="SelectAllBox"
                      Style="{StaticResource PrimaryCheckBox}"
                      Content="Označi / poništi sve redove"
                      HorizontalAlignment="Left"
                      Click="SelectAll_Click"
                      ToolTip="Označi sve redove za brisanje"/>
        </Grid>

        <!-- ══ DataGrid ════════════════════════════════════════════════════ -->
        <DataGrid x:Name="RulesGrid"
                  Grid.Row="2"
                  Margin="20,0,20,0"
                  ItemsSource="{Binding Rules}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  Background="#1F1F1F"
                  Foreground="#F0F0F0"
                  BorderBrush="#383838"
                  BorderThickness="1"
                  RowBackground="#1F1F1F"
                  AlternatingRowBackground="#252525"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2A2A2A"
                  ColumnHeaderHeight="40"
                  RowHeight="64"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <!-- F1-style RED (orange for basketball) column header -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"  Value="#FF6B00"/>
                    <Setter Property="Foreground"  Value="#0A0A0A"/>
                    <Setter Property="FontFamily"  Value="Agency FB, Impact, Arial Black"/>
                    <Setter Property="FontSize"    Value="14"/>
                    <Setter Property="FontWeight"  Value="Bold"/>
                    <Setter Property="Padding"     Value="12,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Cursor"     Value="Hand"/>
                    <Setter Property="Foreground" Value="#F0F0F0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E2E2E"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1F1F1F"/>
                            <Setter Property="BorderBrush" Value="#FF6B00"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"         Value="10,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Col 0: CheckBox (Admin only — shown/hidden in code-behind) -->
                <DataGridTemplateColumn x:Name="CheckCol" Width="52" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Cursor="Hand" ToolTip="Označi za brisanje"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 1: Rule number badge -->
                <DataGridTemplateColumn Header="BR." Width="72" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#3A1F00" BorderBrush="#FF6B00" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Foreground="#FF6B00" FontWeight="Bold" FontSize="15"
                                           FontFamily="Agency FB, Impact, Arial Black"
                                           Text="{Binding RuleNumber}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 2: Title hyperlink (with F1 hover effect) -->
                <DataGridTemplateColumn Header="NAZIV PRAVILA" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="TitleTb"
                                       VerticalAlignment="Center" Margin="4,0"
                                       Cursor="Hand"
                                       Foreground="#FF6B00"
                                       MouseEnter="TitleTb_MouseEnter"
                                       MouseLeave="TitleTb_MouseLeave">
                                <Hyperlink x:Name="TitleLink"
                                           Foreground="#FF6B00"
                                           TextDecorations="None"
                                           Click="TitleLink_Click"
                                           ToolTip="Klikni za detaljan prikaz ili izmenu">
                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 3: Image thumbnail -->
                <DataGridTemplateColumn Header="SLIKA" Width="120" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Width="96" Height="52"
                                    BorderBrush="#383838" BorderThickness="1"
                                    Background="#252525" ClipToBounds="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Stretch="UniformToFill"
                                       Source="{Binding ImagePath, Mode=OneWay, Converter={StaticResource RelImg}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 4: Date added -->
                <DataGridTemplateColumn Header="DATUM DODAVANJA" Width="195" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#888" FontSize="12"
                                       Text="{Binding AddedAt, Mode=OneWay, Converter={StaticResource DtFmt}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state message -->
        <TextBlock x:Name="EmptyLabel"
                   Grid.Row="2"
                   Text="Nema dodatih pravila. Klikni DODAJ da počneš."
                   Foreground="#555" FontFamily="Segoe UI" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- ══ Footer — user info + stats (F1 pattern) ═══════════════════ -->
        <Grid Grid.Row="3" Margin="20,10,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logged-in user badge -->
            <Border Grid.Column="0"
                    Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                    CornerRadius="4" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_User" Height="16" Width="16"
                                    Foreground="#FF6B00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Foreground="#666" FontFamily="Segoe UI" FontSize="11"
                               VerticalAlignment="Center" Text="PRIJAVLJEN KAO"/>
                    <Border x:Name="RoleBadge" Background="#FF6B00" CornerRadius="3"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RoleLabel"
                                   Foreground="#0A0A0A"
                                   FontFamily="Agency FB, Impact, Arial Black" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Stats right side -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                        CornerRadius="4" Padding="14,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_ListAlt" Height="16" Width="16"
                                        Foreground="#FF6B00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="#555" FontFamily="Segoe UI" FontSize="10" Text="UKUPNO PRAVILA"/>
                            <TextBlock x:Name="TotalLabel"
                                       Foreground="White"
                                       FontFamily="Agency FB, Impact, Arial Black" FontSize="18"
                                       Margin="0,-4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1"
                        CornerRadius="4" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_Clock" Height="16" Width="16"
                                        Foreground="#FF6B00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="#555" FontFamily="Segoe UI" FontSize="10" Text="POSLEDNJE DODATO"/>
                            <TextBlock x:Name="LastAddedLabel"
                                       Foreground="White"
                                       FontFamily="Agency FB, Impact, Arial Black" FontSize="18"
                                       Margin="0,-4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
