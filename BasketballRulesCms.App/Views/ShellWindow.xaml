<Window x:Class="BasketballRulesCms.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:notif="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        Title="Basketball Rules CMS"
        Width="1000" Height="700"
        MinWidth="900" MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Title bar button style -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width"           Value="44"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#888"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#EEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CC2200"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#151515"
            BorderBrush="#FF6B00"
            BorderThickness="1"
            CornerRadius="0"
            Effect="{StaticResource ShadowM}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Custom Title Bar ─────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="#1F1F1F"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + branding -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- Basketball SVG icon -->
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="22" Height="22" Canvas.Left="1" Canvas.Top="1"
                                         Stroke="#FF6B00" StrokeThickness="2" Fill="#1F1F1F"/>
                                <Line X1="1" Y1="12" X2="23" Y2="12" Stroke="#FF6B00" StrokeThickness="1.5"/>
                                <Line X1="12" Y1="1" X2="12" Y2="23" Stroke="#FF6B00" StrokeThickness="1.5"/>
                                <Path Data="M5,4 Q12,10 5,20"  Stroke="#FF6B00" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path Data="M19,4 Q12,10 19,20" Stroke="#FF6B00" StrokeThickness="1.5" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="BASKETBALL RULES CMS"
                                   Foreground="#F0F0F0"
                                   FontFamily="Agency FB, Impact, Arial Black"
                                   FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBtn}" Click="Minimize_Click" ToolTip="Minimiziraj">
                            <fa5:SvgAwesome Icon="Solid_WindowMinimize" Height="10" Foreground="#888"/>
                        </Button>
                        <Button Style="{StaticResource TitleBtn}" Click="MaxRestore_Click" ToolTip="Maksimizuj">
                            <fa5:SvgAwesome x:Name="MaxIcon" Icon="Regular_Square" Height="10" Foreground="#888"/>
                        </Button>
                        <Button Style="{StaticResource CloseTitleBtn}" Click="Close_Click" ToolTip="Zatvori">
                            <fa5:SvgAwesome Icon="Solid_Times" Height="10" Foreground="#888"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Orange accent line under title bar (F1 pattern) -->
            <Rectangle Grid.Row="0" Height="2" VerticalAlignment="Bottom" Fill="#FF6B00"/>

            <!-- Page host + Toast overlay -->
            <Grid Grid.Row="1">
                <notif:NotificationArea x:Name="NotifArea"
                                        Panel.ZIndex="999"
                                        MaxItems="3"
                                        Position="TopRight"/>
                <Frame x:Name="RootFrame"
                       NavigationUIVisibility="Hidden"
                       Background="#151515"/>
            </Grid>
        </Grid>
    </Border>
</Window>
